# Uses saved Codex CLI login. No Anthropic or OpenAI API key needed.
# Leave blank to find codex on PATH. Set an absolute path if needed.
CODEX_BIN=
# Optional: a model available to your Codex login; blank uses the CLI default.
CODEX_MODEL=
CODEX_TIMEOUT_SECONDS=120
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=week1-hockey
