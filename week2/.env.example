CODEX_BIN=
CODEX_MODEL=
CODEX_TIMEOUT_SECONDS=120
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Host-only key for the simple nearby-place tiles. Members do not configure this.
GEOAPIFY_API_KEY=
GOOGLE_PLACES_API_KEY=
FOURSQUARE_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=week2-group-referee
# Optional booking texts. Off by default; outbound messages incur provider charges.
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional absolute path to durable private storage; blank uses week2/data.
REFEREE_DATA_DIR=

# Host-managed invitation base URL. Leave blank/local for this local-only prototype.
# Public sharing requires secure hosting/authentication before changing this.
PUBLIC_APP_URL=http://127.0.0.1:8502
